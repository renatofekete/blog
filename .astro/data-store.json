o-code-token-function)\">    setUser\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\">(data);\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-foreground)\">  }\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-token-function)\">  fetchUser\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\">();\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-foreground)\">}\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-punctuation)\">,\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\"> []);\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>Runs once after the component mounts.\u003C/p>\n\u003Ch3 id=\"values-inside-dependency-array\">Values inside dependency array\u003C/h3>\n\u003Cpre class=\"astro-code css-variables\" style=\"background-color:var(--astro-code-background);color:var(--astro-code-foreground); overflow-x: auto;\" tabindex=\"0\" data-language=\"js\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-token-function)\">useEffect\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\">(() \u003C/span>\u003Cspan style=\"color:var(--astro-code-token-keyword)\">=>\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\"> {\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-token-keyword)\">  async\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-keyword)\"> function\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-function)\"> fetchUser\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\">() {\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-token-keyword)\">    const\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-constant)\"> res\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-keyword)\"> =\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-keyword)\"> await\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-function)\"> fetch\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\">(\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-string-expression)\">`/api/user/\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-keyword)\">${\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\">userId\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-keyword)\">}\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-string-expression)\">`\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\">);\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-token-keyword)\">    const\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-constant)\"> data\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-keyword)\"> =\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-keyword)\"> await\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-constant)\"> res\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-function)\">.json\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\">();\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-token-function)\">    setUser\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\">(data);\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-foreground)\">  }\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-token-function)\">  fetchUser\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\">();\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:var(--astro-code-foreground)\">}\u003C/span>\u003Cspan style=\"color:var(--astro-code-token-punctuation)\">,\u003C/span>\u003Cspan style=\"color:var(--astro-code-foreground)\"> [userId]);\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>It runs only when dependency changes.\u003C/p>",{"headings":32,"localImagePaths":50,"remoteImagePaths":51,"frontmatter":52,"imagePaths":56},[33,37,40,44,47],{"depth":34,"slug":35,"text":36},2,"what-useeffect-actually-is","What useEffect actually is",{"depth":34,"slug":38,"text":39},"dependency-array-traps","Dependency array traps",{"depth":41,"slug":42,"text":43},3,"no-dependency-array","No dependency array",{"depth":41,"slug":45,"text":46},"empty-dependency-array","Empty dependency array",{"depth":41,"slug":48,"text":49},"values-inside-dependency-array","Values inside dependency array",[],[],{"pubDate":53,"author":17,"title":14,"description":16,"image":54,"tags":55},["Date","2026-05-05T00:00:00.000Z"],{"url":27,"alt":20},[22,23],[],"who-am-i",{"id":57,"data":59,"body":66,"filePath":67,"assetImports":68,"digest":69,"rendered":70},{"title":60,"pubDate":61,"description":62,"author":17,"image":63,"tags":64},"Who am I, and what will you find here",["Date","2026-04-26T00:00:00.000Z"],"Web developer from Croatia. Writing about JavaScript, React, and building things in public.",{"url":19,"alt":20},[65],"About","7+ years writing frontend code. I never wrote about it. That changes now.\r\n\r\n## Background\r\n\r\nI'm Renato, a web developer, working mostly on frontend codebases. I'm from Beli Manastir, a small town in Croatia, so all my development experience has been remote, be it as a freelancer, or a part of different sized teams.\r\n\r\nI've spent the last few years building websites and apps for clients, and I'm currently looking for my next role while working on a few projects in public.\r\n\r\nThis blog exists for two reasons. First, I want to document what I'm actually building. Second, writing is a way for me to learn things on a deeper level - if I can't explain it, I don't know it well enough.\r\n\r\n## What I'll write about\r\n\r\n- Building in public - I'm currently learning Next.js and building a link shortener from scratch. I'll document the process as I go.\r\n- Small JavaScript tools and open source experiments.\r\n- Web development deep dives.","src/content/posts/who-am-i.md",[27],"9c1d3541f1fef289",{"html":71,"metadata":72},"\u003Cp>7+ years writing frontend code. I never wrote about it. That changes now.\u003C/p>\n\u003Ch2 id=\"background\">Background\u003C/h2>\n\u003Cp>I’m Renato, a web developer, working mostly on frontend codebases. I’m from Beli Manastir, a small town in Croatia, so all my development experience has been remote, be it as a freelancer, or a part of different sized teams.\u003C/p>\n\u003Cp>I’ve spent the last few years building websites and apps for clients, and I’m currently looking for my next role while working on a few projects in public.\u003C/p>\n\u003Cp>This blog exists for two reasons. First, I want to document what I’m actually building. Second, writing is a way for me to learn things on a deeper level - if I can’t explain it, I don’t know it well enough.\u003C/p>\n\u003Ch2 id=\"what-ill-write-about\">What I’ll write about\u003C/h2>\n\u003Cul>\n\u003Cli>Building in public - I’m currently learning Next.js and building a link shortener from scratch. I’ll document the process as I go.\u003C/li>\n\u003Cli>Small JavaScript tools and open source experiments.\u003C/li>\n\u003Cli>Web development deep dives.\u003C/li>\n\u003C/ul>",{"headings":73,"localImagePaths":80,"remoteImagePaths":81,"frontmatter":82,"imagePaths":86},[74,77],{"depth":34,"slug":75,"text":76},"background","Background",{"depth":34,"slug":78,"text":79},"what-ill-write-about","What I’ll write about",[],[],{"pubDate":83,"author":17,"title":60,"description":62,"image":84,"tags":85},["Date","2026-04-26T00:00:00.000Z"],{"url":27,"alt":20},[65],[]]